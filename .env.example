DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/insightflow_ai_db
APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-development-secret
AUTO_CREATE_SCHEMA=true
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=5
ACCESS_TOKEN_EXPIRY_SECONDS=3600
TOKEN_ISSUER=insightflow-api
TOKEN_AUDIENCE=insightflow-client
PASSWORD_RESET_EXPIRY_MINUTES=30
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
